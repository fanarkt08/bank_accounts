PORT=3000
MONGO_URI=mongodb://localhost:27017/bank_accounts
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
# Origines autorisées en CORS, séparées par des virgules (ex.
# "https://mon-front.com,http://localhost:5173"). Laisser vide/absent pour
# autoriser toute origine (pratique en développement).
CORS_ORIGIN=
# true/false : active l'option SSL/TLS de connexion Mongoose. Laisser vide
# pour ne rien forcer (par défaut suffisant en local ; MongoDB Atlas gère
# déjà le chiffrement via son URI mongodb+srv://).
MONGO_SSL=
